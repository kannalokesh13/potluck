# Copy this file to .env and fill in your values. .env is git-ignored.

# Neon connection string (leave out to use in-memory storage).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: pin one board so http://127.0.0.1:8000/ always opens the same board.
POTLUCK_BOARD_ID=local-test
